{
  "name": "hurstify",
  "version": "2.1.0",
  "description": "Randomized Kolmogorov-Smirnov Analysis of Volatility Roughness",
  "type": "module",
  "main": "dist/index.cjs",
  "browser": "dist/index.iife.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "homepage": "https://github.com/sachncs/hurstify#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/sachncs"
  },
  "scripts": {
    "lint": "eslint lib/ tests/ experiments/ && prettier --check lib/ tests/ experiments/",
    "lint:fix": "eslint --fix lib/ tests/ experiments/ && prettier --write lib/ tests/ experiments/",
    "dev:demo": "next dev demo -p 5173",
    "build:demo": "next build demo",
    "start:demo": "next start demo -p 5173",
    "lint:demo": "prettier --check demo/",
    "test": "mocha \"tests/**/*.tests.js\"",
    "test:watch": "npm test -- --watch",
    "test:coverage": "NODE_ENV=test c8 --all --include=lib/* --reporter=html --reporter=text mocha \"tests/**/*.tests.js\"",
    "docs": "jsdoc2md './lib/**/*.js' > ./API.md",
    "build": "rollup --config rollup.dist.config.js",
    "build:full": "npm run docs && npm run build",
    "setup": "./scripts/setup.sh",
    "cleanup": "./scripts/cleanup.sh",
    "prepare": "node .husky/install.mjs"
  },
  "babel": {
    "presets": [
      "@babel/env"
    ],
    "env": {
      "test": {
        "plugins": [
          "istanbul"
        ]
      }
    }
  },
  "nyc": {
    "sourceMap": false,
    "instrument": false
  },
  "targets": "> 0.25%, not dead",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sachncs/hurstify.git"
  },
  "keywords": [
    "kolmogorov-smirnov",
    "hurst",
    "rough-volatility",
    "fractional-brownian-motion",
    "volatility",
    "statistics"
  ],
  "author": "Sachin <sachncs@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sachncs/randomized-kolmogorov-smirnov-analysis-of-volatility-roughness/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "diff": "^8.0.4",
    "glob": "^13.0.0",
    "serialize-javascript": "^7.0.7"
  },
  "files": [
    "dist",
    "API.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.3.6",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.3",
    "@radix-ui/react-slot": "^1.2.16",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "html-to-image": "^1.11.13",
    "husky": "^9.1.7",
    "jsdoc-to-markdown": "^9.1.3",
    "lint-staged": "^17.3.0",
    "lucide-react": "^1.34.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "recharts": "^3.10.1",
    "rollup": "^4.63.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "zod": "^3.23.0"
  }
}
